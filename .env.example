# ─────────────────────────────────────────────────────────────
# A2V — Variables d'environnement (exemple, aucun secret réel)
# Copiez ce fichier vers .env pour le développement local.
# Sur Vercel, renseignez ces variables dans Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Application
APP_URL=http://localhost:3000
APP_NAME=A2V
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=fr-FR

# Base de données PostgreSQL (obligatoire)
# Développement : npm run db:start puis l'URL locale ci-dessous.
DATABASE_URL=postgresql://postgres:a2v_local_dev@127.0.0.1:5433/a2v
# Vercel : DATABASE_URL doit pointer vers la base hébergée (Postgres du Marketplace).
# Utilisez de préférence l'URL poolée pour l'exécution (Neon/Vercel Postgres).
# DIRECT_URL = URL non poolée, utilisée uniquement par les migrations.
# DIRECT_URL=postgresql://user:password@host:5432/a2v?sslmode=require
# Exemple Neon/Supabase : ajoutez ?sslmode=require (et pgbouncer=true si nécessaire).

# Sécurité — générez des valeurs aléatoires (openssl rand -base64 48)
SESSION_SECRET=change-me-please-64-random-bytes
CRON_SECRET=change-me-cron-secret
IP_HASH_SALT=change-me-ip-salt
# Active les routes de simulation de paiement. À laisser true pour la démonstration.
PAYMENTS_SIMULATION=true

# E-mail transactionnel (SMTP). Si absent : mode console (liens journalisés).
EMAIL_FROM="A2V <no-reply@a2v.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Stripe (marketplace / Connect). Non requis pour le mode simulation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=

# La Poste / transporteur officiel. Non requis en mode simulation.
LAPOSTE_API_KEY=
LAPOSTE_WEBHOOK_SECRET=
LAPOSTE_API_BASE=https://api.laposte.fr
SHIPPING_MODE=simulation

# Stockage des images.
# local = développement uniquement (disque éphémère sur Vercel).
# vercel-blob = production Vercel (store Blob du Marketplace).
# Un store connecté en OIDC fournit BLOB_STORE_ID ; le token statique est optionnel.
STORAGE_DRIVER=local
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Uniquement pour la démonstration : peuple une base vide au premier build Vercel.
SEED_DEMO_DATA=false

# Paramètres métier par défaut (modifiables ensuite via l'administration)
COMMISSION_RATE_BPS=50
PREMIUM_PRICE_CENTS=1500
PREMIUM_TRIAL_DAYS=90

# Base PostgreSQL locale embarquée (scripts/dev-db.mjs) — inutile sur Vercel.
A2V_DB_PORT=5433
A2V_DB_PASSWORD=a2v_local_dev
